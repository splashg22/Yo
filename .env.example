# Copy to .env.local. Nothing here is needed for the local validator.

# local: a validator on this machine, with pump.fun and the Rings programs copied from devnet.
# devnet: not wired up yet. See DECISIONS.md.
RING_NETWORK=local
LOCAL_RPC_URL=http://127.0.0.1:8899

# For the devnet pass. Server-side only: never prefix it with NEXT_PUBLIC_.
HELIUS_API_KEY=

# Where the local server keeps its state and the mock Ring's escrow key.
APP_DATA_DIR=.data

# Only for scripts that copy accounts from devnet (npm run local:fetch).
DEVNET_RPC_URL=https://api.devnet.solana.com
