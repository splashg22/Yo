# --- Connection -------------------------------------------------------------
# Mainnet RPC URL. Holder snapshots need getProgramAccounts on the token
# programs (or a Helius-style getTokenAccounts API); many free RPCs block it.
RPC_URL=

# Path to the treasury keypair file (solana-keygen format). Keep it OUTSIDE
# this folder. The treasury must be the creator of STRATEGY_MINT.
TREASURY_KEYPAIR_PATH=

# --- Tokens -----------------------------------------------------------------
# Your pump.fun coin (paired with TTWO). Its creator fees fund everything.
STRATEGY_MINT=
# The coin that is bought and burned (DCTY).
BURN_MINT=9hjBLBrc7WZW2H8UQvBAvG5WiTZotXUv2Bdcn4f4pump
# The coin whose holders receive the TTWO rewards. Leave empty to reward
# holders of STRATEGY_MINT (your coin).
HOLDER_MINT=
# Optional safety check: the TTWO mint. The bot reads the pair token from the
# chain; if this is set and does not match, it refuses to run.
EXPECTED_QUOTE_MINT=

# --- Who qualifies ----------------------------------------------------------
# Minimum HOLDER_MINT balance (whole tokens) to receive rewards.
MIN_HOLD=
# Comma-separated wallets that never receive rewards (optional).
EXCLUDE_WALLETS=
# Skip program-owned (off-curve) addresses such as pools and bonding curves.
EXCLUDE_PROGRAM_OWNED=true

# --- Safety -----------------------------------------------------------------
# true = simulate only: nothing is sent, nothing is written to data/.
DRY_RUN=true
# Most TTWO (whole tokens) swapped into BURN_MINT in one cycle. The rest waits.
MAX_SWAP_TTWO_PER_CYCLE=1
SLIPPAGE_BPS=300

# --- Swap -------------------------------------------------------------------
# auto = use pump's own route when one exists, otherwise Jupiter.
SWAP_VENUE=auto
JUPITER_API_URL=https://api.jup.ag/swap/v1
# Optional. Free key from Jupiter's developer portal; without one, requests
# are limited to about one every two seconds.
JUPITER_API_KEY=
# Most SOL (network fees + account rent) a Jupiter swap may cost the treasury.
MAX_SWAP_SOL_COST=0.02

# --- Tuning -----------------------------------------------------------------
# Don't claim / swap / distribute below these amounts of TTWO (whole tokens).
MIN_CLAIM_TTWO=0
MIN_SWAP_TTWO=0
MIN_DISTRIBUTE_TTWO=0
# Holders whose share is below this stay unpaid this round (saves account rent).
MIN_PAYOUT_TTWO=0
PAYOUTS_PER_TX=5
PRIORITY_FEE_MICROLAMPORTS=10000
LOOP_INTERVAL_SECONDS=600
DATA_DIR=data
