# One settings file per coin: .env for the default coin (DA City), .env.<coin>
# for any other, e.g. .env.llm for LLM Launchpad. `npm run setup:env [coin]`
# writes it for you.

# --- Coin -------------------------------------------------------------------
# Which coin this file is for: a file name from brands/ (dacity, llm, ...).
# It sets the names and tickers shown in the terminal, alerts and proof page.
BRAND=dacity

# --- Connection -------------------------------------------------------------
# Mainnet RPC URL. Holder snapshots need getProgramAccounts on the token
# programs (or a Helius-style getTokenAccounts API); many free RPCs block it.
RPC_URL=

# Path to the treasury keypair file (solana-keygen format). Keep it OUTSIDE
# this folder. The treasury must be the creator of STRATEGY_MINT.
TREASURY_KEYPAIR_PATH=

# --- Tokens -----------------------------------------------------------------
# Your pump.fun coin, paired with a tokenized stock (TTWO, ANT, ...). Its
# creator fees, paid in that stock, fund everything.
STRATEGY_MINT=
# The coin that is bought and burned. Leave empty for the brand's own choice:
# DCTY for dacity; for llm the coin buys back and burns itself.
BURN_MINT=
# The coin whose holders receive the stock rewards. Leave empty to reward
# holders of STRATEGY_MINT (your coin).
HOLDER_MINT=
# Optional safety check: the mint of the stock token the coin is paired with.
# The bot reads the pair from the chain; if this is set and does not match, it
# refuses to run. Worth setting when a stock has several tokenized versions.
EXPECTED_QUOTE_MINT=
# Optional: override the tickers the brand shows.
COIN_SYMBOL=
QUOTE_SYMBOL=
BURN_SYMBOL=

# --- Who qualifies ----------------------------------------------------------
# Minimum HOLDER_MINT balance (whole tokens) to receive rewards.
MIN_HOLD=
# Comma-separated wallets that never receive rewards (optional).
EXCLUDE_WALLETS=
# Skip program-owned (off-curve) addresses such as pools and bonding curves.
EXCLUDE_PROGRAM_OWNED=true

# --- Safety -----------------------------------------------------------------
# true = simulate only: nothing is sent, nothing is written to data/.
DRY_RUN=true
# Most of the stock token (whole tokens, e.g. 1 = one share) swapped into the
# burn coin in one cycle. The rest waits.
MAX_SWAP_PER_CYCLE=1
SLIPPAGE_BPS=300
# A live cycle is skipped while the treasury has less SOL than this (it needs
# SOL for network fees and for holders' first-time stock-token accounts).
MIN_SOL_BALANCE=0.05

# --- Swap -------------------------------------------------------------------
# auto = use pump's own route when one exists, otherwise Jupiter.
SWAP_VENUE=auto
JUPITER_API_URL=https://api.jup.ag/swap/v1
# Optional. Free key from Jupiter's developer portal; without one, requests
# are limited to about one every two seconds.
JUPITER_API_KEY=
# Most SOL (network fees + account rent) a Jupiter swap may cost the treasury.
MAX_SWAP_SOL_COST=0.02

# --- Alerts (optional) ------------------------------------------------------
# The loop posts a short message after each cycle that did something, and
# when something goes wrong. These are secrets: keep them only in .env.
DISCORD_WEBHOOK_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Heading of the public pages. Empty = the brand's title.
REPORT_TITLE=

# --- Tuning -----------------------------------------------------------------
# Don't claim / swap / distribute below these amounts of the stock token
# (whole tokens).
MIN_CLAIM=0
MIN_SWAP=0
MIN_DISTRIBUTE=0
# Holders whose share is below this stay unpaid this round (saves account rent).
MIN_PAYOUT=0
PAYOUTS_PER_TX=5
PRIORITY_FEE_MICROLAMPORTS=10000
LOOP_INTERVAL_SECONDS=600
# Where this coin's books live. Empty = data/ for dacity, data/<coin>/ otherwise.
DATA_DIR=

# --- Public proof page (web/) -----------------------------------------------
# `npm run web [coin]` writes the page's config.json from the values above plus these.
# The page runs in visitors' browsers, so this RPC must be key-free and public.
# Never put RPC_URL here if it carries an API key.
PUBLIC_RPC_URL=https://solana-rpc.publicnode.com
# Ticker shown for the coin whose holders are paid, when HOLDER_MINT is set (optional).
HOLDER_SYMBOL=
# Link to the source code shown in the page footer (optional).
REPO_URL=
