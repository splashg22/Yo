# Every setting the site reads, in one place. Copy to .env.local on your own machine.
# In a cloud session or on a host, enter these in its environment settings instead.
# Nothing here is needed to run on the local validator: every line has a working default.

# --- Where it runs -----------------------------------------------------------------
# local: a validator on this machine, with pump.fun and the Rings programs copied from devnet.
# devnet: Solana devnet through Helius. With HELIUS_API_KEY set, Ring balances are the real Privacy Rings program (alpha).
RING_NETWORK=local

# RING_NETWORK=mainnet is READ ONLY, always. The server shows mainnet's coins and trades and refuses to build,
# sign or send anything there. No setting switches that off. It needs HELIUS_API_KEY or MAINNET_RPC_URL.
# MAINNET_RPC_URL=

# Where the indexer's data comes from.
#   rpc        whole blocks over the RPC. Right for the local chain and devnet. The default.
#   helius-ws  Helius's transaction stream (needs the Developer plan or above). WRITTEN, NEVER RUN: see TERMINAL-FEATURES.md.
FEED_PROVIDER=rpc
# How much the stream carries.
#   coins  new coins, plus every trade of the coins somebody has open and of the newest ones. The cheapest plan. The default.
#   all    every pump.fun and pool trade. Needs a full stream; on Helius alone it costs about ten times the Developer plan.
FEED_SCOPE=coins
# With FEED_SCOPE=all: which pool programs besides pump.fun's own are read. "pump" always is.
# Add meteora-damm2 for Meteora DAMM v2 pools against SOL: about a third more stream to carry (see TERMINAL-FEATURES.md section 11).
FEED_VENUES=pump
# With FEED_SCOPE=coins: how many of the newest coins are followed trade by trade. More costs more credits.
FEED_FOLLOW_NEWEST=300
LOCAL_RPC_URL=http://127.0.0.1:8799

# Helius key. Needed for devnet. Server-side only: never prefix it with NEXT_PUBLIC_.
HELIUS_API_KEY=

# An explicit devnet address instead of Helius. Also used by `npm run local:fetch`.
DEVNET_RPC_URL=

# --- Where things are kept ---------------------------------------------------------
# Folder for local keys, uploaded pictures and, without a database server, the embedded database.
APP_DATA_DIR=.data

# Postgres connection string. Unset: an embedded Postgres under APP_DATA_DIR is used (fine on one machine).
DATABASE_URL=
# The schema its tables live in, so several deployments can share a database.
DATABASE_SCHEMA=ringpad

# Pinata key for coin pictures on IPFS. Unset: pictures are kept under APP_DATA_DIR.
PINATA_JWT=

# --- The site ----------------------------------------------------------------------
# The site's public address, for link previews and for the address written into a coin's details.
SITE_URL=http://localhost:4710

# Set to put the whole site behind this password (any user name). Unset: open to whoever can reach it.
PREVIEW_PASSWORD=

# The sealed launch window. It holds buyers' funds. "on" or "off".
FEATURE_SEALED_WINDOW=off

# How many proxies of your own sit in front of the server (a host's load balancer is usually 1).
# It decides whose address a request is counted against. 0: the address the connection came from is used.
TRUSTED_PROXY_HOPS=0

# How long one call to the chain may take, in milliseconds.
RPC_TIMEOUT_MS=20000

# --- The server ---------------------------------------------------------------------
PORT=4710
# debug, info, warn or error. Logs are one JSON object per line.
LOG_LEVEL=info
# How long a wallet's session lasts, in minutes (1 to 720). A session can read that wallet's own records; it cannot move anything.
SESSION_MINUTES=60
# The most live connections one address may hold open at once.
WS_MAX_PER_ADDRESS=30
# Set to let whoever holds it run the housekeeping now (POST /admin/reconcile). Unset: that address does not exist.
ADMIN_TOKEN=

# --- Sending ------------------------------------------------------------------------
# Extra RPC addresses a signed transaction is also sent to, comma separated. Unset: the main RPC only.
SEND_RPC_URLS=
# The account a tip to Jito's block builders is paid to. Mainnet only. Unset: no tip is ever added.
JITO_TIP_ACCOUNT=

# --- This site's own fee -------------------------------------------------------------
# All off unless set. Rates are hundredths of a percent, at most 300 (3%). A fee is paid in public, by its
# own instruction in the same transaction, and is shown before anyone signs.
# The wallet the fee is paid to. It must already exist on the chain and hold some SOL.
FEE_WALLET=
# Share of the SOL a trade moves, on the curve or in a pool. Proposed: 50 (0.5%). See DECISIONS.md.
FEE_TRADE_BPS=0
# A flat charge for a launch, in lamports. Proposed: 0.
FEE_LAUNCH_LAMPORTS=0
# Share of an OTC block's price, paid by the buyer on top. Proposed: 25 (0.25%).
FEE_OTC_BPS=0
