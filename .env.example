# Every setting the site reads, in one place. Copy to .env.local on your own machine.
# In a cloud session or on a host, enter these in its environment settings instead.
# Nothing here is needed to run on the local validator: every line has a working default.

# --- Where it runs -----------------------------------------------------------------
# local: a validator on this machine, with pump.fun and the Rings programs copied from devnet.
# devnet: Solana devnet through Helius. Ring balances are not connected there yet.
RING_NETWORK=local
LOCAL_RPC_URL=http://127.0.0.1:8799

# Helius key. Needed for devnet. Server-side only: never prefix it with NEXT_PUBLIC_.
HELIUS_API_KEY=

# An explicit devnet address instead of Helius. Also used by `npm run local:fetch`.
DEVNET_RPC_URL=

# --- Where things are kept ---------------------------------------------------------
# Folder for local keys, uploaded pictures and, without a database, the state file.
APP_DATA_DIR=.data

# Postgres connection string. Unset: the state is kept in a file under APP_DATA_DIR.
DATABASE_URL=
# The schema its one table lives in, so several deployments can share a database.
DATABASE_SCHEMA=ringpad

# Pinata key for coin pictures on IPFS. Unset: pictures are kept under APP_DATA_DIR.
PINATA_JWT=

# --- The site ----------------------------------------------------------------------
# The site's public address, for link previews and for the address written into a coin's details.
SITE_URL=http://localhost:4710

# Set to put the whole site behind this password (any user name). Unset: open to whoever can reach it.
PREVIEW_PASSWORD=

# The sealed launch window. It holds buyers' funds. "on" or "off".
FEATURE_SEALED_WINDOW=off

# How many proxies of your own sit in front of the server (a host's load balancer is usually 1).
# It decides whose address a request is counted against. 0: the forwarding header is ignored.
TRUSTED_PROXY_HOPS=0

# How long one call to the chain may take, in milliseconds.
RPC_TIMEOUT_MS=20000
