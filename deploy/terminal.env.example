# Launch A: the terminal. Solana mainnet, read only. Copy the names into the host's environment; values are yours.
# Nothing here is a wallet key, and this build cannot send a transaction on mainnet whatever is set.
RING_NETWORK=mainnet
HELIUS_API_KEY=                 # Helius Developer plan. The only secret in this file.
FEED_PROVIDER=helius-ws         # the live stream
FEED_SCOPE=coins                # plan A: new coins, and the coins being followed
FEED_VENUES=pump                # Meteora needs the full stream: not on plan A
FEED_FOLLOW_NEWEST=300
DATABASE_URL=                   # Postgres. Leave empty to keep data on the host's disk instead (lost on redeploy without a volume)
SITE_URL=https://               # the public address, no trailing slash
PREVIEW_PASSWORD=               # set to keep the link private at first; empty makes it public
ADMIN_TOKEN=                    # any long random text; guards /admin
TRUSTED_PROXY_HOPS=1            # one proxy in front on Railway; makes the per-visitor limits count visitors, not the proxy
NODE_USE_ENV_PROXY=0
