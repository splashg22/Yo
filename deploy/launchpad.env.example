# Launch B: the launchpad. Solana devnet, with the real Privacy Rings program. Coins and SOL here have no value.
RING_NETWORK=devnet
HELIUS_API_KEY=                 # a Helius key; the free plan reaches devnet. The only secret in this file.
FEED_PROVIDER=rpc               # whole blocks from devnet: its volume is small
FEED_SCOPE=coins
DATABASE_URL=                   # Postgres, or empty with a volume mounted at /data
SITE_URL=https://
PREVIEW_PASSWORD=
ADMIN_TOKEN=
TRUSTED_PROXY_HOPS=1
PINATA_JWT=                     # optional: coin pictures pinned to IPFS. Empty: kept on this server (needs the volume)
FEATURE_OTC=off                 # built on the stand-in only
FEATURE_PAY_LINKS=off           # built on the stand-in only
FEATURE_SEALED_WINDOW=off       # holds buyers' funds: stays off
FEE_TRADE_BPS=0
