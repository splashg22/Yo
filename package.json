{
  "name": "ringpad",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "next dev -p 4710",
    "build": "next build",
    "start": "next start -p 4710",
    "test": "npm run test:site && npm run test:flows",
    "typecheck": "tsc --noEmit",
    "standins": "node scripts/make-standins.mjs",
    "media": "node scripts/build-media.mjs",
    "shots": "node scripts/screenshots.mjs",
    "local:fetch": "tsx scripts/fetch-local-accounts.ts",
    "local": "bash scripts/local-validator.sh",
    "e2e": "tsx scripts/e2e.mjs",
    "test:site": "vitest run --config vitest.site.config.ts",
    "test:flows": "vitest run --config vitest.flows.config.ts",
    "test:flows:pg": "bash scripts/local-postgres.sh start && DATABASE_URL=postgresql://postgres@127.0.0.1:5544/postgres vitest run --config vitest.flows.config.ts; code=$?; bash scripts/local-postgres.sh stop; exit $code",
    "example": "tsx examples/launch-and-transfer.ts",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm test",
    "measure": "node scripts/measure.mjs",
    "crawl": "node scripts/crawl.mjs",
    "break": "tsx scripts/break.mjs",
    "motion": "node scripts/motion.mjs",
    "scan": "node scripts/scan-secrets.mjs",
    "doctor": "tsx scripts/doctor.ts",
    "postgres:start": "bash scripts/local-postgres.sh start",
    "postgres:stop": "bash scripts/local-postgres.sh stop",
    "local:plan": "tsx scripts/plan-local-accounts.ts"
  },
  "dependencies": {
    "@heliuslabs/spr": "0.9.0-alpha",
    "@noble/ciphers": "2.4.0",
    "@noble/curves": "2.4.0",
    "@noble/hashes": "2.4.0",
    "@pump-fun/pump-sdk": "4.3.1",
    "@solana/kit": "8.6.0",
    "@solana/spl-token": "0.4.15",
    "@solana/web3.js": "1.99.0",
    "@wallet-standard/app": "1.1.1",
    "@wallet-standard/base": "1.1.1",
    "bn.js": "5.2.5",
    "bs58": "6.0.0",
    "libsodium-wrappers": "0.7.15",
    "next": "16.4.6",
    "pg": "8.16.3",
    "qrcode": "1.5.4",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/bn.js": "5.2.0",
    "@types/libsodium-wrappers": "0.7.14",
    "@types/node": "26.6.6",
    "@types/pg": "8.15.5",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.14.0",
    "prettier": "3.10.1",
    "sharp": "0.35.5",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.73.0",
    "vitest": "5.1.1"
  }
}
