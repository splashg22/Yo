{
  "name": "ringpad",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "standins": "node scripts/make-standins.mjs",
    "media": "node scripts/build-media.mjs",
    "shots": "node scripts/screenshots.mjs",
    "local:fetch": "tsx scripts/probe-accounts.ts && tsx scripts/probe-ring-accounts.ts && tsx scripts/fetch-local-accounts.ts",
    "local": "bash scripts/local-validator.sh",
    "e2e": "node scripts/e2e.mjs"
  },
  "dependencies": {
    "@heliuslabs/spr": "^0.9.0-alpha",
    "@noble/ciphers": "^2.4.0",
    "@noble/curves": "^2.4.0",
    "@noble/hashes": "^2.4.0",
    "@pump-fun/pump-sdk": "^4.3.1",
    "@solana/kit": "^8.6.0",
    "@solana/spl-token": "^0.4.15",
    "@solana/web3.js": "^1.99.0",
    "@wallet-standard/app": "^1.1.1",
    "@wallet-standard/base": "^1.1.1",
    "bn.js": "^5.2.5",
    "bs58": "^6.0.0",
    "next": "^16.4.6",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/bn.js": "^5.2.0",
    "@types/node": "^26.6.6",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "sharp": "^0.35.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1"
  }
}
